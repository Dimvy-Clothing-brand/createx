{
  "name": "createx-backend",
  "version": "1.0.0",
  "description": "Backend API for CreateX smart contract factory",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "node scripts/build.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "deploy:contracts": "node src/scripts/deploy.js",
    "verify:contracts": "node src/scripts/verify.js",
    "vercel:deploy": "vercel --prod",
    "vercel:preview": "vercel",
    "vercel:env": "vercel env pull .env.local"
  },
  "keywords": [
    "createx",
    "blockchain",
    "ethereum",
    "smart-contracts",
    "api",
    "backend"
  ],
  "author": "CreateX Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "viem": "^2.21.54",
    "wagmi": "^2.14.5",
    "compression": "^1.7.5",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "node-cache": "^5.1.2",
    "winston": "^3.17.0",
    "joi": "^17.13.3",
    "axios": "^1.7.9",
    "web3": "^4.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
